# ── 정보시스템 자산관리 환경변수 ──
# 복사: cp .env.example .env  (운영 서버는 setup-nginx.sh 가 생성 — 이 파일은 개발 PC·값 목록 참조용)
# 이 파일은 저장소에 추적되고 .env 는 제외된다. 실제 시크릿을 여기 쓰지 말 것.

# ── 필수 ──
# 세션 서명 키. 48바이트 이상 무작위. 없으면 기동 시 경고 + 개발용 기본값(운영 금지).
#   생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-generate-a-random-48-byte-secret

# ── 런타임 ──
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
TZ=Asia/Seoul
# 내부 Next 포트 (운영: nginx 가 443 → 127.0.0.1:3100 으로 프록시. 공존시스템이 3000 을 쓰므로 3100)
PORT=3000
HOSTNAME=127.0.0.1

# ── 데이터 ──
# SQLite 파일 경로. 상대경로면 ASSET_DB_CWD 기준. 테스트는 임시 경로를 넣어 운영 DB 를 건드리지 않는다.
ASSET_DB_PATH=./data.db
ASSET_DB_CWD=.
# 백업/프루닝 상호배제 lockfile (운영: /var/lib/asset-inventory/maintenance.lock)
ASSET_LOCK_PATH=./.maintenance.lock

# ── 인증/세션 ──
# 세션 수명(시간). 기본 8 = 근무 1일. 공용 PC 환경이면 4 권장.
SESSION_TTL_HOURS=8
# HTTPS 뒤에서만 true (nginx TLS 종단 시 true). 로컬 http 개발은 false.
COOKIE_SECURE=false
# nginx 등 리버스프록시 뒤에서 X-Forwarded-For 를 신뢰해 실제 클라이언트 IP 를 쓴다(허용 IP·접속기록·잠금에 사용).
#   프록시 없이 직접 노출이면 false (그렇지 않으면 IP 헤더를 위조할 수 있다).
TRUST_PROXY=false
# 2단계 인증 등록을 강제할 역할 (쉼표 구분). 기본 admin. 전원 선택으로 두려면 none.
MFA_REQUIRED_ROLES=admin

# ── 외부 접속 ──
# 메일 링크·안내에 쓰는 공개 도메인 (nginx server_name 과 동일)
PUBLIC_FQDN=itam.example.go.kr

# ── 알림 ──
# 알림 채널. inapp 만 두면 메일 설정 화면과 무관하게 메일 발송이 차단된다. 메일도 쓰려면 inapp,email
NOTIFICATION_CHANNELS=inapp,email
