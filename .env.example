# 정보시스템 자산 현황관리 시스템 — 환경 설정 예시
# 실제 배포 시 이 파일을 .env 로 복사한 뒤 값을 채우세요.

# 폐쇄망: Next.js 텔레메트리 비활성화
NEXT_TELEMETRY_DISABLED=1

# 타임존 (권장). 감사/접속 로그 시각을 서버 OS 타임존과 무관하게 고정한다.
#   미설정 시 앱은 서버 OS 로컬시간을 따르므로, OS가 UTC면 로그가 KST와 9시간 어긋난다.
TZ=Asia/Seoul

# 인증 시크릿 (필수, 운영 시 반드시 강력한 무작위 값으로 변경)
# 생성 예: openssl rand -base64 48
# 미설정 또는 기본값이면 기동 시 보안 경고가 발생합니다.
AUTH_SECRET=

# HTTPS(Node TLS) 사용 시 세션 쿠키 secure 플래그 (P12에서 true 권장)
# COOKIE_SECURE=true

# 이메일 알림 채널 마스터 스위치 (선택). 메일 릴레이 발송 전역 제어.
#   미설정      → ON (실제 발송은 설정 → 메일 설정의 enabled 토글 + 서버정보 완비가 결정)
#   inapp,email → ON
#   inapp       → 강제 OFF (스테이징/검증 등에서 메일 발송 차단)
# NOTIFICATION_CHANNELS=inapp,email
